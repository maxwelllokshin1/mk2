<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pi_drive</name>
  <version>0.1.0</version>
  <description>Joy-Con teleop + autonomy gating, and a Raspberry Pi GPIO servo/ESC driver (no Ackermann messages, no MCU)</description>
  <maintainer email="maxwell.lokshin@2zick.com">ubuntu</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>ackermann_msgs</depend>
  <exec_depend>follow_the_gap</exec_depend>
  <exec_depend>urg_node2</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
