# Starts the whole car (Joy-Con, driver, LiDAR, autonomy, dashboard, OLED, person detection) at power-on.
# The car stays idle until a controller connects; the dashboard shows whether one is connected.
#
# Install on the Pi (host, not in the container). If your Linux user or repo path differs, edit User= and the paths:
#   sudo cp scripts/pi/racer.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now racer
#   systemctl status racer          # started?
#   scripts/pi/car.sh logs          # the car's own log
# Turn it off again:  sudo systemctl disable --now racer   (then  scripts/pi/car.sh stop)
[Unit]
Description=Racer car (docker compose)
After=docker.service bluetooth.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=maxwelllokshin
WorkingDirectory=/home/maxwelllokshin/mk2
ExecStart=/home/maxwelllokshin/mk2/scripts/pi/car.sh boot
ExecStop=/home/maxwelllokshin/mk2/scripts/pi/car.sh stop
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
